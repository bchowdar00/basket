{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": { "suffix": { "type": "string" }, "location": { "type": "string", "defaultValue": "westus" }, "tenant": { "type": "string" }, "writer": { "type": "string" }, "engine": { "type": "string" } },
  "variables": {
    "kv": "[concat('vaultkeys', parameters('suffix'))]",
    "officer": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'b86a8fe4-44ce-4948-aee5-eccb2c155cd7')]",
    "user": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '4633458b-17de-408a-b874-0445c86b69e6')]"
  },
  "resources": [
    { "type": "Microsoft.KeyVault/vaults", "apiVersion": "2023-07-01", "name": "[variables('kv')]", "location": "[parameters('location')]",
      "properties": { "tenantId": "[parameters('tenant')]", "sku": { "family": "A", "name": "standard" }, "enableRbacAuthorization": true, "enableSoftDelete": true, "softDeleteRetentionInDays": 7, "publicNetworkAccess": "Enabled" } },
    { "type": "Microsoft.Authorization/roleAssignments", "apiVersion": "2022-04-01", "scope": "[format('Microsoft.KeyVault/vaults/{0}', variables('kv'))]",
      "name": "[guid(variables('kv'), parameters('writer'), 'officer')]", "dependsOn": [ "[resourceId('Microsoft.KeyVault/vaults', variables('kv'))]" ],
      "properties": { "roleDefinitionId": "[variables('officer')]", "principalId": "[parameters('writer')]", "principalType": "User" } },
    { "type": "Microsoft.Authorization/roleAssignments", "apiVersion": "2022-04-01", "scope": "[format('Microsoft.KeyVault/vaults/{0}', variables('kv'))]",
      "name": "[guid(variables('kv'), parameters('engine'), 'user')]", "dependsOn": [ "[resourceId('Microsoft.KeyVault/vaults', variables('kv'))]" ],
      "properties": { "roleDefinitionId": "[variables('user')]", "principalId": "[parameters('engine')]", "principalType": "ServicePrincipal" } }
  ],
  "outputs": { "uri": { "type": "string", "value": "[reference(resourceId('Microsoft.KeyVault/vaults', variables('kv')), '2023-07-01').vaultUri]" } }
}
